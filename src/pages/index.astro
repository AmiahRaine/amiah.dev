---
import AmiahFace from '../components/AmiahFace.astro';
import WorkExperience from '../components/WorkExperience.astro';
import MainLayout from '../layouts/MainLayout.astro';

import '../styles/resume.css';
---

<MainLayout title="Amiah">
	<aside>
		
		<div class="main-info">
			<AmiahFace/>
		
			<div class="name-major">
				<div class="name">Amiah Raine</div>
				<small class="major">Computer Science, BS</small>
			</div>


			<label for="collapse-info-button">
				<input type="checkbox" id="collapse-info-button" checked />
			</label>
		</div>

		<div class="collapsible-info">
			<div class="pinfo-list">
				<div class="pinfo">
					Minnesota, USA
				</div>
				<a class="pinfo" href="mailto:contact@amiah.dev">
					contact@amiah.dev
				</a>
				<a class="pinfo" href="https://github.com/AmiahRaine">
					GitHub
				</a>
				<a class="pinfo" href="https://www.linkedin.com/in/amiahraine">
					LinkedIn
				</a>
			</div>
		</div>
	</aside>
	<main>
		<article class="resume-body">
			<section>
				<h2>Professional Summary</h2>
				<hr/>
				<p>Summa cum laude Computer Science graduate. Strong skills in back-end and front-end development. Academic achievements and work experience reflect a commitment to excellence, analytical thinking, and problem-solving skills.</p>
			</section>
			<section>
				<h2>Skills</h2>
				<hr/>
				<div class="skill-lists">
					<!-- Languages and the like -->
					<ul>
						<li>Java</li><li>Kotlin</li><li>Python</li><li>TypeScript</li><li>HTML&CSS</li><li>SQL</li><li>JSON</li><li>Bash</li>
					</ul>
					<!-- Frameworks, libraries, etc -->
					<ul>
						<li>Spring Boot</li><li>REST APIs</li><li>Android</li><li>MariaDB</li><li>React</li><li>Git</li>
					</ul>
					<!-- Soft Skills -->
					<ul>
						<li>Communication</li><li>Collaboration</li><li>Detail-Oriented</li><li>Problem-Solving</li><li>Organization</li>
					</ul>
				</div>
			</section>
			<section>
				<h2>Education</h2>
				<hr/>
				<h3>Computer Science, BS</h3>
				<div class="education-detail">Lakeland University, WI, 2023 - 2025</div>
				<div class="education-detail">Anoka-Ramsey CC, MN, 2021 - 2023</div>
			</section>
			<section>
				<h2>Work Experience</h2>
				<hr/>
				<WorkExperience 
					title='Tech Internship'
					company='MNOHS'
					date='June 2026 - August 2026'
					desc='Worked on creation of new website. Created presentations and communicated technology needs with stakeholders.'
				/>

				<WorkExperience 
					title='Customer Care'
					company='Wyoming Drug'
					date='June 2022 - October 2023'
					desc='Provided amiable customer service and processed transactions. Opened and closed store, stocked shelves, faced products, and performed maintenance tasks.'
				/>
				
			</section>
			<section>
				<h2>Projects</h2>
				<hr/>
				<p>Work in Progess. Will be updated soon!</p>
			</section>
		</article>
	</main>
</MainLayout>
