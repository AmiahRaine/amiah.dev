---
import AmiahFace from '../components/AmiahFace.astro';
import Pinfo from '../components/Pinfo.astro';
import Project from '../components/Project.astro';
import WorkExperience from '../components/WorkExperience.astro';
import MainLayout from '../layouts/MainLayout.astro';

import '../styles/resume.css';
---

<MainLayout title="Amiah">
	<aside>
		<div class="main-info">
			<div class="face-name">
				<AmiahFace/>
			
				<div class="name-major">
					<div class="name">Amiah Raine</div>
					<small class="major">Computer Science, BS</small>
				</div>
			</div>

			<label for="collapse-info-button">
				<div id="aside-menu-toggle-icon" />
				<input type="checkbox" id="collapse-info-button" checked />
			</label>
		</div>

		<div class="collapsible-info">
			<div class="pinfo-list">
				<Pinfo 
					label='Minnesota, USA'
					img='/icons/location-pointer.svg'
				/>
				<Pinfo 
					label='contact@amiah.dev'
					link='mailto:contact@amiah.dev'
					img='/icons/email.svg'
				/>
				<Pinfo 
					label='GitHub'
					link='https://github.com/AmiahRaine'
					img='/icons/code.svg'
				/>
				<Pinfo 
					label='LinkedIn'
					link='https://www.linkedin.com/in/amiahraine'
					img='/icons/business.svg'
				/>
			</div>
		</div>
	</aside>
	<main>
		<article class="resume-body">
			<section>
				<h2>Professional Summary</h2>
				<hr/>
				<p><i>Summa cum laude</i> Computer Science graduate. Strong skills in back-end and front-end development. Academic achievements and work experience reflect a commitment to excellence, analytical thinking, and problem-solving skills.</p>
			</section>
			<section>
				<h2>Skills</h2>
				<hr/>
				<div class="skill-lists">
					<!-- Languages and the like -->
					<ul>
						<li>Java</li><li>Kotlin</li><li>Python</li><li>TypeScript</li><li>JavaScript</li><li>HTML&CSS</li><li>SQL</li><li>JSON</li><li>Bash</li>
					</ul>
					<!-- Frameworks, libraries, etc -->
					<ul>
						<li>Spring Boot</li><li>REST APIs</li><li>Android</li><li>MariaDB</li><li>MySQL</li><li>React</li><li>Git</li>
					</ul>
					<!-- Soft Skills -->
					<ul>
						<li>Communication</li><li>Collaboration</li><li>Detail-Oriented</li><li>Problem-Solving</li><li>Organization</li>
					</ul>
				</div>
			</section>
			<section>
				<h2>Education</h2>
				<hr/>
				<h3>Computer Science, BS</h3>
				<div class="education-detail">Lakeland University, WI, 2023 - 2025</div>
				<div class="education-detail">Anoka-Ramsey CC, MN, 2021 - 2023</div>
			</section>
			<section>
				<h2>Work Experience</h2>
				<hr/>
				<WorkExperience 
					title='Tech Internship'
					company='MNOHS'
					date='June 2026 - August 2026'
					desc='Worked on creation of new website. Created presentations and communicated technology needs with stakeholders.'
				/>

				<WorkExperience 
					title='Customer Care'
					company='Wyoming Drug'
					date='June 2022 - October 2023'
					desc='Provided amiable customer service and processed transactions. Opened and closed store, stocked shelves, faced products, and performed maintenance tasks.'
				/>
				
			</section>
			<section>
				<h2>Projects</h2>
				<hr/>
				<Project 
					title='Budget Tracker'
					link='https://github.com/AmiahRaine/budget-tracker'
					desc='Web application for tracking expenses and reviewing balances. Utilizes a REST API to communicate between the Spring Boot back-end and the React front-end. Uses MariaDB and Hibernate JPA for data persistence.'
				/>
				<Project
					title="To-do Notes App"
					link="https://github.com/AmiahRaine/ephemeral-notes"
					desc="Android to-do and notes app using Kotlin and Jetpack Compose. Features automatically generated weekly task pages and long-term, user-created reminders. Uses Android Room for data persistence."
				/>
				<Project
					title="Hardware Specification Getter"
					link="https://github.com/AmiahRaine/hardware-spec-get"
					desc="JavaFX application that displays detailed hardware specs. Features customizable information panels with options for icons, order, and visibility. Data persistence handled with Jackson JSON, and dependencies managed with Maven."
				/>
				<Project
					title="Image Noise Generator"
					link="https://github.com/AmiahRaine/python_noise_generator"
					desc="Python TKinter application for generating image noise using PIL. Generates seed-based customizable grayscale and color noise. Can be exported to be used for graphics or other purposes."
				/>
				<Project
					title="Auto Firefox Debian Installer Script"
					link="https://github.com/AmiahRaine/apt-install-firefox-script"
					desc="Shell script that imports Mozilla's signing key and configures package pinning to solve dependency issues with the Firefox .deb package. Provides user-friendly options and completion status."
				/>
			</section>
		</article>
	</main>
</MainLayout>
